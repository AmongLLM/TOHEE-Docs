{
  "name": "tohee-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "npm run docs:build && npm run docs:check",
    "docs:build": "node scripts/build-docs.mjs --version preview",
    "docs:check": "node scripts/build-docs.mjs --version preview --check",
    "test": "node --test \"tests/*.test.mjs\"",
    "preview:build": "node scripts/build-preview-docs.mjs && ng build --configuration production",
    "preview:dev": "node scripts/build-preview-docs.mjs && ng serve --host 127.0.0.1"
  },
  "devDependencies": {
    "marked": "18.1.3",
    "@angular/build": "21.2.29",
    "@angular/cli": "21.2.29",
    "@angular/compiler-cli": "21.2.25",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  }
}
