{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run preview:build",
  "outputDirectory": "dist/preview",
  "rewrites": [
    { "source": "/docs", "destination": "/index.html" },
    { "source": "/docs/:id([a-z0-9-]+)", "destination": "/index.html" }
  ]
}
